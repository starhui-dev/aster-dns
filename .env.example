# Copy to .env and replace every <...> placeholder before use.
APP_ENV=development
APP_LISTEN_ADDR=:8080
APP_PUBLIC_URL=http://localhost:5173
APP_COMPOSE_PUBLIC_URL=http://localhost:8080
APP_DATABASE_URL=postgres://aster_dns:<replace-with-url-safe-random-password>@127.0.0.1:5432/aster_dns?sslmode=disable

# Required whenever APP_DATABASE_URL is configured. Generate with: openssl rand -base64 32
APP_MASTER_KEY=

# Required only until the first administrator is enrolled.
# Generate unpadded base64url: openssl rand 32 | base64 -w0 | tr '+/' '-_' | tr -d '='
APP_BOOTSTRAP_TOKEN=
APP_PASSWORD_LOGIN_ENABLED=false
APP_LOG_LEVEL=info
APP_WEB_DIR=

APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=1
APP_DB_CONNECT_TIMEOUT=5s
APP_SHUTDOWN_TIMEOUT=15s
APP_AUTH_SESSION_IDLE_TTL=30m
APP_AUTH_SESSION_ABSOLUTE_TTL=24h
APP_AUTH_SESSION_REFRESH_INTERVAL=1m
APP_AUTH_CHALLENGE_TTL=5m
APP_AUTH_ENROLLMENT_TTL=24h


POSTGRES_DB=aster_dns
POSTGRES_USER=aster_dns
POSTGRES_PASSWORD=<replace-with-url-safe-random-password>
POSTGRES_PORT=5432
APP_PORT=8080
