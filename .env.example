# Copy to .env and replace every <...> placeholder before use.
# Keep this file out of source control; use APP_ENV=production only with HTTPS.
APP_ENV=development
APP_LISTEN_ADDR=:8080

# Native Vite origin. For production use the externally visible https:// origin.
APP_PUBLIC_URL=http://localhost:5173
# Container origin used by compose; it must match the browser-visible origin.
APP_COMPOSE_PUBLIC_URL=http://localhost:8080
APP_DATABASE_URL=postgres://aster_dns:<replace-with-url-safe-random-password>@127.0.0.1:5432/aster_dns?sslmode=disable
POSTGRES_SSLMODE=disable

# Set exactly one of APP_MASTER_KEY or APP_MASTER_KEY_FILE.
# Generate: openssl rand -base64 32
APP_MASTER_KEY=
APP_MASTER_KEY_FILE=
APP_MASTER_KEY_VERSION=1
# JSON object of old version -> base64 key; leave empty unless rotating keys.
APP_PREVIOUS_MASTER_KEYS=

# Required until the first administrator completes bootstrap with a password or Passkey.
# Generate: openssl rand 32 | base64 -w0 | tr '+/' '-_' | tr -d '='
APP_BOOTSTRAP_TOKEN=
APP_PASSWORD_LOGIN_ENABLED=true
APP_LOG_LEVEL=info
APP_WEB_DIR=

APP_DB_MAX_CONNS=10
APP_DB_MIN_CONNS=1
APP_DB_MAX_CONN_LIFETIME=30m
APP_DB_MAX_CONN_IDLE_TIME=5m
APP_DB_HEALTH_CHECK_PERIOD=1m
APP_DB_CONNECT_TIMEOUT=5s
APP_SHUTDOWN_TIMEOUT=15s
APP_HTTP_READ_HEADER_TIMEOUT=5s
APP_HTTP_READ_TIMEOUT=15s
APP_HTTP_WRITE_TIMEOUT=30s
APP_HTTP_IDLE_TIMEOUT=2m
APP_HTTP_MAX_HEADER_BYTES=1048576
APP_READY_TIMEOUT=2s
APP_TRUSTED_PROXY_CIDRS=
APP_ZONE_SYNC_INTERVAL=15m
APP_AUTH_SESSION_IDLE_TTL=30m
APP_AUTH_SESSION_ABSOLUTE_TTL=24h
APP_AUTH_SESSION_REFRESH_INTERVAL=1m
APP_AUTH_CHALLENGE_TTL=5m
APP_AUTH_ENROLLMENT_TTL=24h

# These identify the local PostgreSQL database; POSTGRES_PASSWORD is the only credential.
POSTGRES_DB=aster_dns
POSTGRES_USER=aster_dns
POSTGRES_PASSWORD=<replace-with-url-safe-random-password>
POSTGRES_PORT=5432
APP_PORT=8080
